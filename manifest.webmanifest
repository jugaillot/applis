{
  "name": "La Suite",
  "short_name": "La Suite",
  "description": "Outils d'atelier : séparation riso, vectorisation, compilation de PDF.",
  "lang": "fr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f1efea",
  "theme_color": "#1d1d1f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Envoyer un dessin",
      "short_name": "Envoyer",
      "url": "/envoyer/"
    },
    {
      "name": "Riso",
      "url": "/riso/"
    },
    {
      "name": "Vecto",
      "url": "/vecto/"
    },
    {
      "name": "PDF",
      "url": "/compil/"
    },
    {
      "name": "CAD",
      "url": "/plan/"
    },
    {
      "name": "Photo",
      "url": "/photo/"
    },
    {
      "name": "Dossiers",
      "url": "/dossiers/"
    },
    {
      "name": "Mise en page",
      "url": "/mise/"
    },
    {
      "name": "Paysage insulaire",
      "url": "/paysage/"
    },
    {
      "name": "Civco",
      "url": "/civco/"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-pptx.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/",
      "accept": {
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-doc.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-dxf.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}