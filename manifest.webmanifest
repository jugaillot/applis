        {
          "src": "/icons/file-dxf.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-doc-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-doc-48.png",
