{
  "name": "La Suite",
  "short_name": "La Suite",
  "description": "Outils d'atelier : séparation riso, vectorisation, compilation de PDF.",
  "lang": "fr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f1efea",
  "theme_color": "#1d1d1f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Envoyer un dessin",
      "short_name": "Envoyer",
      "url": "/envoyer/"
    },
    {
      "name": "Riso",
      "url": "/riso/"
    },
    {
      "name": "Vecto",
      "url": "/vecto/"
    },
    {
      "name": "PDF",
      "url": "/compil/"
    },
    {
      "name": "CAD",
      "url": "/plan/"
    },
    {
      "name": "Photo",
      "url": "/photo/"
    },
    {
      "name": "Dossiers",
      "url": "/dossiers/"
    },
    {
      "name": "Mise en page",
      "url": "/mise/"
    },
    {
      "name": "Paysage insulaire",
      "url": "/paysage/"
    },
    {
      "name": "Civco",
      "url": "/civco/"
    }
  ],
  "file_handlers": [
    {
      "action": "/open/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-pdf-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pdf-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pdf-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pdf-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pdf.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-image-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-image-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/icons/file-image-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/icons/file-image-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/icons/file-image.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "image/svg+xml": [
          ".svg"
        ],
        "application/postscript": [
          ".ai",
          ".eps"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-svg-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-svg-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/icons/file-svg-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/icons/file-svg-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/icons/file-svg.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-pptx-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pptx-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pptx-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pptx-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/icons/file-pptx.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-doc-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-doc-48.png",
