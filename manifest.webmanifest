{
  "name": "La Suite",
  "short_name": "La Suite",
  "description": "Outils d'atelier : séparation riso, vectorisation, compilation de PDF.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f1efea",
  "theme_color": "#1d1d1f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Riso",
      "url": "/riso/"
    },
    {
      "name": "Vecto",
      "url": "/vecto/"
    },
    {
      "name": "PDF",
      "url": "/compil/"
    },
    {
      "name": "CAD",
      "url": "/plan/"
    },
    {
      "name": "Photo",
      "url": "/photo/"
    },
    {
      "name": "Dossiers",
      "url": "/dossiers/"
    },
    {
      "name": "Paysage insulaire",
      "url": "/paysage/"
    },
    {
      "name": "Civco",
      "url": "/civco/"
    }
  ],
  "file_handlers": [
    {
      "action": "/compil/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client",
      "icons": [
        {
          "src": "/icons/file-pdf.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "/photo/",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ]
      },
      "launch_type": "single-client",
      "icons": [
        {
          "src": "/icons/file-image.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "/vecto/",
      "accept": {
        "image/svg+xml": [
          ".svg"
        ]
      },
      "launch_type": "single-client",
      "icons": [
        {
          "src": "/icons/file-svg.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    }
  ]
}
