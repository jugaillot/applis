        },
        {
          "src": "/icons/file-doc.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/open/",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-dxf-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/icons/file-dxf-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
