{
  "name": "Vecto — La Suite",
  "short_name": "Vecto",
  "description": "Dessin vectoriel : SVG, AI, EPS, PDF.",
  "lang": "fr",
  "id": "/vecto/",
  "start_url": "/vecto/",
  "scope": "/vecto/",
  "display": "standalone",
  "background_color": "#f1efea",
  "theme_color": "#1d1d1f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/vecto/",
      "accept": {
        "image/svg+xml": [
          ".svg"
        ],
        "application/postscript": [
          ".ai",
          ".eps"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-svg.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}