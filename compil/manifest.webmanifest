{
  "name": "PDF — La Suite",
  "short_name": "PDF",
  "description": "Assembler, annoter et imposer des PDF.",
  "lang": "fr",
  "id": "/compil/",
  "start_url": "/compil/",
  "scope": "/compil/",
  "display": "standalone",
  "background_color": "#f1efea",
  "theme_color": "#1d1d1f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/compil/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "/icons/file-pdf.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}